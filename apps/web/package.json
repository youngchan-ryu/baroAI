{
  "name": "@baroai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:booth-server": "node --test scripts/booth-server.test.mjs",
    "build": "pnpm typecheck && vite build",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "dev:service": "vite --mode service --host 127.0.0.1",
    "dev:prototype": "vite --mode prototype --host 127.0.0.1",
    "build:demo": "pnpm typecheck && vite build --mode demo",
    "build:service": "pnpm typecheck && vite build --mode service",
    "build:prototype": "pnpm typecheck && vite build --mode prototype"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "i18next": "26.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.2",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
