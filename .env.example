# Application settings. make configure creates project-local credentials.
# Never commit secrets. Existing .env is preserved by configuration tools.
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:5173
LLM_FAKE=true
AUTO_CONFIRM=false
PILOT_NOTICE=true
DEMO_AUTH=true
ALLOWED_EMAIL_DOMAIN=snu.ac.kr

# Fill locally during M1/M2. Do not use placeholder passwords in deployment.
JWT_SECRET=
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_URL_READONLY=
# make redis-configure fills authenticated project-local DB0/DB1 URLs.
REDIS_URL=
TEST_REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=baro-ai-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Resolve available model IDs during B10. Blank IDs forbid live calls.
LLM_PROTOCOL=v1
# Optional text-only Chat Completions options; leave the first unset unless supported.
# LLM_CHAT_REASONING_EFFORT=none
LLM_CHAT_EXPLICIT_CACHE=false
LLM_MAX_OUTPUT_TOKENS=200
LLM_PRIMARY=openai
OPENAI_API_KEY=
OPENAI_MODEL_VISION=
OPENAI_MODEL_TEXT_SMALL=
OPENAI_MODEL_EMBEDDING=
LLM_TIMEOUT_S=20
LLM_PHOTO_WAIT_S=20
LLM_MAX_IMAGES=1
LLM_IMAGE_MAX_SIDE=512
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_DAILY_CALL_CAP=300
DAILY_LLM_BUDGET_USD=5
LLM_PRICE_TABLE={}
LLM_PRICE_AS_OF=
LLM_PRICE_SOURCE=https://openai.com/api/pricing/

# Optional provider, not required for the first live implementation.
CLOVA_API_KEY=
CLOVA_MODEL_VISION=

# B18 SMTP adapter is restricted to loopback verification; no external delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=
SENS_FROM=
SMS_DAILY_CAP=50
TRAVEL_MODE=vehicle

# Service runs use separate .env.service / .env.service.test files (never this demo DB).
DEPLOYMENT_MODE=demo
SERVICE_NAMESPACE=baro_service
MAIL_DELIVERY=disabled
OTP_PEPPER=
MAIL_ENCRYPTION_KEY=
EXPORT_ENCRYPTION_KEY=
SECURE_COOKIE=false
# Service-only paths must be distinct private directories below .local/service/.
# STORAGE_PATH=/absolute/project/.local/service/dev/uploads
# MAIL_SINK_PATH=/absolute/project/.local/service/dev/mail
